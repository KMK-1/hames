{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hames.local/schemas/task-contract-v1.json",
  "title": "Hames workspace-local task contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "revision",
    "state",
    "workspace",
    "request_provenance",
    "approval_provenance",
    "scope",
    "outputs",
    "invariants",
    "acceptance_criteria",
    "required_evidence",
    "spec_hash",
    "timestamps"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "state": {
      "enum": [
        "DRAFT",
        "READY",
        "ACTIVE",
        "REVIEW",
        "ACCEPTED",
        "ARCHIVED",
        "AMENDMENT_PENDING",
        "BLOCKED",
        "FAILED"
      ]
    },
    "workspace": { "type": "string", "minLength": 1 },
    "request_provenance": { "$ref": "#/$defs/provenance" },
    "approval_provenance": { "$ref": "#/$defs/provenance" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude", "protected"],
      "properties": {
        "include": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "protected": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "outputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "invariants": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "acceptance_criteria": { "type": "array", "items": { "$ref": "#/$defs/criterion" } },
    "required_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceRequirement" } },
    "spec_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "updated_at"],
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "actor", "reference", "recorded_at", "advisory"],
      "properties": {
        "source": { "type": "string" },
        "actor": { "type": "string" },
        "reference": { "type": "string" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "advisory": { "const": true }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "command"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "command": { "type": ["string", "null"] }
      }
    }
  }
}
