{
  "permissions": {
    "allow": [
      "Write(.claude/.workspace_lock)",
      "Bash(ls *)",
      "Bash(dir *)",
      "Bash(grep:*)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(tr *)",
      "Bash(printf *)",
      "Bash(echo *)",
      "Bash(md5sum *)",
      "Bash(sha256sum *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(node *compliance_auditor.js*)",
      "Bash(node *session_logger.js*)",
      "Bash(node *task_contract.js*)",
      "Bash(node *verify_edit_surgery.js*)",
      "Bash(node *verify_tasks.js*)",
      "Bash(node *workspace_guard.js*)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(pip install *)",
      "Bash(npm install *)",
      "Bash(npx *)",
      "Bash(winget *)",
      "Bash(git push*)",
      "Bash(git remote add*)",
      "Bash(git remote set-url*)",
      "Bash(gh *)",
      "Bash(vercel *)",
      "Bash(yt-dlp *)",
      "Bash(taskkill *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(Stop-Process *)",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "SessionStart": [{"hooks":[{"type":"command","command":"node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_capture.js\""}]}],
    "PreToolUse": [
      {"matcher":"Write|Edit|MultiEdit|NotebookEdit|Bash|Read","hooks":[{"type":"command","command":"node \"$CLAUDE_PROJECT_DIR/.claude/hooks/enterprise_guard.js\"","statusMessage":"Enterprise security policy check..."}]},
      {"matcher":"Write|Edit|MultiEdit|NotebookEdit|Bash","hooks":[{"type":"command","command":"node \"$CLAUDE_PROJECT_DIR/.claude/hooks/context_verifier.js\""}]},
      {"matcher":"Write|Edit|MultiEdit|NotebookEdit|Bash","hooks":[{"type":"command","command":"node \"$CLAUDE_PROJECT_DIR/.claude/hooks/workspace_guard.js\""}]},
      {"matcher":"Write|Edit|Bash","hooks":[{"type":"command","command":"node \"$CLAUDE_PROJECT_DIR/arsenal/compliance_auditor.js\""}]},
      {"matcher":"Write|Edit|MultiEdit|NotebookEdit|Bash","hooks":[{"type":"command","command":"node \"$CLAUDE_PROJECT_DIR/.claude/hooks/task_contract_guard.js\""}]}
    ],
    "PostToolUse": [
      {"matcher":"Edit","hooks":[{"type":"command","command":"node \"$CLAUDE_PROJECT_DIR/arsenal/verify_edit_surgery.js\""}]},
      {"matcher":"Write|Edit","hooks":[{"type":"command","command":"node \"$CLAUDE_PROJECT_DIR/arsenal/verify_tasks.js\""}]},
      {"matcher":"Write|Edit|MultiEdit|NotebookEdit|Bash","hooks":[{"type":"command","command":"node \"$CLAUDE_PROJECT_DIR/.claude/hooks/task_contract_evidence.js\""}]},
      {"matcher":"Write|Edit","hooks":[{"type":"command","command":"node \"$CLAUDE_PROJECT_DIR/arsenal/session_logger.js\""}]}
    ]
  }
}
